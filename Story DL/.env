# Cau hinh BUILD cho build_exe.bat (khong phai cau hinh runtime cua app).
# Dong bat dau bang # la comment. Khong dat dau cach quanh dau =.
APP_NAME=StoryLoader
# 1 = mot file .exe duy nhat (khoi dong cham hon vai giay); 0 = thu muc (onedir, khoi dong nhanh)
ONEFILE=1
# 1 = an cua so console; 0 = hien console de debug
WINDOWED=1
# Lenh Python dung de tao venv (py -3.12, py -3.11, python...)
PYTHON_CMD=py -3
# Duong dan icon (.ico); de trong neu khong co
ICON=
# 1 = chay pytest truoc khi build
RUN_TESTS=1
